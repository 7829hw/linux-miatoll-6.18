# Native ADSP audio on top of reboot1.
CONFIG_LOCALVERSION="-miatoll-audio1"
# The RAM test carries no modules; build the fork's audio stack in.
CONFIG_SND_SOC_QDSP6=y
CONFIG_SND_SOC_SM8250=y
CONFIG_SND_SOC_TAS2562=y
CONFIG_SND_SOC_WCD937X=y
CONFIG_SND_SOC_WCD937X_SDW=y
CONFIG_SND_SOC_LPASS_RX_MACRO=y
CONFIG_SND_SOC_LPASS_TX_MACRO=y
CONFIG_SND_SOC_LPASS_VA_MACRO=y
CONFIG_SOUNDWIRE_QCOM=y
CONFIG_PINCTRL_LPASS_LPI=y
CONFIG_PINCTRL_SC7280_LPASS_LPI=y
