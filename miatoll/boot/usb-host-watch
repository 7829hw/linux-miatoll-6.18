#!/bin/sh
# Follow USB-C role changes for $1 seconds while the ACM console may be gone.
# Each second the USB role, Type-C port state and attached USB devices go to
# /run/usb-host.log and to the bottom of tty1. A new removable USB disk is set
# read-only and its first 16 MiB are read twice. When the role returns to
# device, the ACM gadget is bound to the new controller again.
seconds=${1:-300}
log=/run/usb-host.log
port=/sys/class/typec/port0
done_disks=
show() {
    echo "$*" >>"$log"
    printf '\0337\033[%s;1H\033[K%s\0338' "$row" "$*" >/dev/tty1
    row=$((row + 1))
}
echo "USB_HOST_WATCH_BEGIN seconds=$seconds" >>"$log"
i=0
while [ "$i" -lt "$seconds" ]; do
    row=30
    # The role switch class has no readable role here; DWC3 debugfs reports it.
    role=$(cat /sys/kernel/debug/usb/a600000.usb/mode 2>/dev/null)
    partner=none
    [ -e "$port/port0-partner" ] && partner=attached
    show "USB t=${i}s role=$role data=$(cat "$port/data_role" 2>/dev/null)" \
         "power=$(cat "$port/power_role" 2>/dev/null) partner=$partner"
    for dev in /sys/bus/usb/devices/*; do
        [ -f "$dev/idVendor" ] || continue
        [ "$(cat "$dev/bDeviceClass")" = 09 ] && continue
        show "  ${dev##*/} $(cat "$dev/idVendor"):$(cat "$dev/idProduct") $(cat "$dev/product" 2>/dev/null)"
    done
    for disk in /sys/block/sd*; do
        name=${disk##*/}
        [ "$(cat "$disk/removable")" = 1 ] || continue
        case " $done_disks " in *" $name "*) continue ;; esac
        done_disks="$done_disks $name"
        blockdev --setro "/dev/$name"
        for pass in 1 2; do
            echo 3 >/proc/sys/vm/drop_caches
            hash=$(dd if="/dev/$name" bs=1M count=16 2>/run/usb-dd.err | sha256sum | cut -d' ' -f1)
            echo "USB_DISK_READ $name ro=$(blockdev --getro "/dev/$name") pass=$pass sha256=$hash" >>"$log"
            cat /run/usb-dd.err >>"$log"
        done
    done
    for disk in $done_disks; do
        show "  disk $disk $(grep -c "^USB_DISK_READ $disk " "$log") reads, last $(grep "^USB_DISK_READ $disk " "$log" | tail -n 1 | cut -c1-60)"
    done
    for input in /sys/class/input/input*; do
        case "$(readlink -f "$input")" in */usb*) show "  input $(cat "$input/name")" ;; esac
    done
    if [ "$role" = device ] && [ -z "$(cat /sys/kernel/config/usb_gadget/miatoll-boot1/UDC 2>/dev/null)" ]; then
        /bin/usb-gadget >>"$log" 2>&1 && echo "USB_GADGET_REBOUND t=$i" >>"$log"
    fi
    i=$((i + 1))
    sleep 1
done
echo 'USB_HOST_WATCH_END' >>"$log"
