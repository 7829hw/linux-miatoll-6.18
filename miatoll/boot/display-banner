#!/bin/sh
# Paint a VT test banner only after a native MSM framebuffer appears.
name=$(tr -d '\000' </sys/firmware/devicetree/base/chosen/miatoll,boot-profile)
name=${name%-ram-only}
tag=$(echo "$name" | tr a-z A-Z)
# Title such as "DISPLAY TEST 2" or "TOUCH TEST 1".
title="$(echo "${name%%[0-9]*}" | tr a-z A-Z) TEST ${name##*[a-z]}"
attempt=0
while [ "$attempt" -lt 60 ]; do
    for fb in /sys/class/graphics/fb*; do
        [ -f "$fb/name" ] || continue
        if grep -q '^msmdrmfb$' "$fb/name"; then
            if [ -c /dev/tty1 ]; then
                if [ "$name" != display1 ]; then
                    if ! printf '0\n' >"$fb/blank"; then
                        echo "${tag}_UNBLANK_FAILED: $fb"
                        exit 1
                    fi
                    echo "${tag}_UNBLANK_REQUESTED: $fb"
                fi
                printf '\033[2J\033[H\033[1;37;44m\n  MIATOLL LINUX %s  \n\033[0m\n' "$title" >/dev/tty1
                printf '  %s\n\n' "$(uname -r)" >/dev/tty1
                printf '\033[1;31m  RED     \033[32mGREEN     \033[34mBLUE\033[0m\n\n' >/dev/tty1
                printf '  Huaxing panel: expected 1080 x 2400\n\n  Report the visible text and colours.\n' >/dev/tty1
                echo "${tag}_BANNER_WRITTEN: $fb via tty1"
                exit 0
            fi
        fi
    done
    attempt=$((attempt + 1))
    sleep 1
done
echo "${tag}_BANNER_UNAVAILABLE: native MSM framebuffer or tty1 did not appear"
exit 1
