#!/bin/sh
tag=DISPLAY1
if [ "$(tr '\000' '\n' </sys/firmware/devicetree/base/chosen/miatoll,boot-profile)" = 'display2-ram-only' ]; then
    tag=DISPLAY2
fi
echo "${tag}_PROBE_BEGIN"
/bin/boot-probe
echo '--- native framebuffer ---'
for fb in /sys/class/graphics/fb*; do
    [ -d "$fb" ] || continue
    echo "$fb"
    for attribute in name virtual_size bits_per_pixel modes blank; do
        [ -f "$fb/$attribute" ] || continue
        printf '%s=' "$attribute"
        cat "$fb/$attribute"
    done
done
echo '--- DSI connectors ---'
for connector in /sys/class/drm/card*-DSI-*; do
    [ -d "$connector" ] || continue
    echo "$connector"
    for attribute in status enabled modes dpms; do
        [ -f "$connector/$attribute" ] || continue
        printf '%s=' "$attribute"
        cat "$connector/$attribute"
    done
done
echo '--- DRM atomic state ---'
for state in /sys/kernel/debug/dri/*/state; do
    [ -f "$state" ] || continue
    echo "$state"
    cat "$state"
done
echo '--- backlight ---'
for backlight in /sys/class/backlight/*; do
    [ -d "$backlight" ] || continue
    echo "$backlight"
    for attribute in brightness actual_brightness max_brightness bl_power; do
        [ -f "$backlight/$attribute" ] || continue
        printf '%s=' "$attribute"
        cat "$backlight/$attribute"
    done
done
echo '--- banner result ---'
cat /run/display-banner.log 2>/dev/null
echo '--- interrupts ---'
cat /proc/interrupts
echo '--- regulator state ---'
cat /sys/kernel/debug/regulator/regulator_summary 2>/dev/null
echo '--- display clocks ---'
if [ -r /sys/kernel/debug/clk/clk_summary ]; then
    head -n 2 /sys/kernel/debug/clk/clk_summary
    grep -Ei 'disp_cc|dsi.*pll|dsi_phy' /sys/kernel/debug/clk/clk_summary
fi
echo "${tag}_PROBE_END"
